#!/bin/sh
# 提交成功后自动部署 Web 隧道（zcode.skillpie.cn）；daemon 相关变更时追加发行包发布。
#
# 设计要点：
# - 后台执行不阻塞提交；部署脚本自身的验证输出与失败信息只落在日志文件。
# - 产物从**当前工作区**构建（与手动执行 deploy_web.sh 行为一致）：提交后立刻
#   改文件的话，后台部署可能带上未提交内容。
# - rebase / merge / cherry-pick 的自动提交不触发部署，避免提交风暴。
# - 锁目录防并发：上一次部署未结束时跳过本次触发，不排队（Web 部署与发行包
#   发布共用同一把锁，在同一个后台任务里串行执行）。
# - 发行包自动发布：提交涉及 daemon 运行时路径（apps/zcode-cli、server-cli 的
#   依赖闭包覆盖的 packages/*，排除纯前端包）或根清单/锁文件时，Web 部署完成后
#   追加 `deploy_web.sh --release`。发行包依赖闭包在打包时动态解析，此清单为
#   保守近似，新增 daemon 依赖包时同步扩充。win32-x64 不在自动发布目标内
#   （RELEASE_TARGETS 默认 darwin-arm64 + linux-x64），需要时手动执行。

git_dir="$(git rev-parse --git-dir 2>/dev/null)" || exit 0
if [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ] || [ -f "$git_dir/MERGE_HEAD" ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)" || exit 0
deploy_sh="$repo_root/deploy_web.sh"
[ -f "$deploy_sh" ] || exit 0

log_dir="$HOME/.zcode/logs"
log_file="$log_dir/web-tunnel-deploy.log"
release_log_file="$log_dir/web-tunnel-release.log"
lock_dir="$log_dir/web-tunnel-deploy.lock"

# 本次提交是否触及 daemon 运行时路径（0 = 否）。
daemon_changed="$(git show --name-only --format="" HEAD 2>/dev/null | grep -cE '^(apps/zcode-cli/|packages/(zcode-server-cli|shared|rpc|services|client|server|provider|provider-node|model-option-map)/|pnpm-lock\.yaml$|package\.json$)')" || daemon_changed=0

if [ -d "$lock_dir" ]; then
  echo "[post-commit] Web 隧道部署已在后台执行，跳过本次触发（日志: $log_file）"
  exit 0
fi

mkdir -p "$log_dir" || exit 0
if [ "$daemon_changed" != "0" ]; then
  echo "[post-commit] Web 隧道部署已在后台触发（含 daemon 变更，稍后自动发布发行包），日志: $log_file / $release_log_file"
else
  echo "[post-commit] Web 隧道部署已在后台触发，日志: $log_file"
fi

LOCK="$lock_dir" LOG="$log_file" RELEASE_LOG="$release_log_file" DEPLOY_SH="$deploy_sh" \
REPO_ROOT="$repo_root" DAEMON_CHANGED="$daemon_changed" \
nohup sh -c '
  mkdir "$LOCK" 2>/dev/null || exit 0
  echo "===== $(date "+%F %T") commit-triggered deploy start ($REPO_ROOT)" >> "$LOG"
  bash "$DEPLOY_SH" >> "$LOG" 2>&1
  code=$?
  echo "===== $(date "+%F %T") deploy end (exit=$code)" >> "$LOG"
  if [ "$DAEMON_CHANGED" != "0" ]; then
    echo "===== $(date "+%F %T") commit-triggered release start" >> "$RELEASE_LOG"
    bash "$DEPLOY_SH" --release >> "$RELEASE_LOG" 2>&1
    rcode=$?
    echo "===== $(date "+%F %T") release end (exit=$rcode)" >> "$RELEASE_LOG"
  fi
  rmdir "$LOCK" 2>/dev/null
' >/dev/null 2>&1 &

exit 0
