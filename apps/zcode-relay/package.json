{
  "name": "@zcode/relay",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx src/entry.ts",
    "lint": "oxlint src",
    "test": "tsx --test test/*.test.ts",
    "build": "esbuild src/entry.ts --bundle --platform=node --format=esm --outfile=dist/entry.js --external:bufferutil --external:utf-8-validate --banner:js=\"import{createRequire}from 'module';const require=createRequire(import.meta.url);\"",
    "build:report": "esbuild src/dailyReport/cli.ts --bundle --platform=node --format=esm --outfile=dist/daily-report.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.0",
    "@zcode/shared": "workspace:*",
    "hono": "^4.12.9",
    "ws": "^8.20.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2"
  }
}
